# Copie para a RAIZ do projeto no servidor como ".env" e preencha. NUNCA commite o .env.

# Subdominio apontado (registro A) para o IP do VPS
VITTA_DOMAIN=vitta.seudominio.com.br
# Opcional: enderecos das home pages das corretoras (separados por espaco, entre aspas)
VITTA_SITE_DOMAINS=

# Senhas fortes. Gere com:  openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_KEY=

# Primeiro usuario (criado so se o banco nao tiver nenhum)
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# IA (opcional; sem chave o Vitta usa a heuristica por nomes de coluna)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
AI_MODEL=claude-haiku-5-5

# E-mail diario (opcional). Com o plano da Hostinger: crie uma conta de e-mail no hPanel (ex.: vitta@seudominio)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Backup automatico: horario (cron, Brasilia) e dias guardados no servidor (pasta ./backups)
BACKUP_SCHEDULE=0 3 * * *
BACKUP_KEEP_DAYS=14
# Copia para a nuvem (opcional, ver deploy/backup/README.md). Ex.: gdrive:vitta-backups
RCLONE_REMOTE=
