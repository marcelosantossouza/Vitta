# Copie para a RAIZ do projeto no servidor como ".env" e preencha. NUNCA commite o .env.

# Subdominio apontado (registro A) para o IP do VPS
VITTA_DOMAIN=vitta.seudominio.com.br

# Senhas fortes. Gere com:  openssl rand -base64 32
POSTGRES_PASSWORD=
JWT_KEY=

# Primeiro usuario (criado so se o banco nao tiver nenhum)
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# IA (opcional; sem chave o Vitta usa a heuristica por nomes de coluna)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
AI_MODEL=claude-haiku-5-5
