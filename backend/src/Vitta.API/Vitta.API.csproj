<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>vitta-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vitta.Application\Vitta.Application.csproj" />
    <ProjectReference Include="..\Vitta.Infrastructure\Vitta.Infrastructure.csproj" />
    <ProjectReference Include="..\Vitta.Persistence\Vitta.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- O source generator do Mediator roda no projeto host e gera o dispatcher em tempo de compilacao. -->
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
